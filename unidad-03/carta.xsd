<?xml version="1.0" encoding="UTF-8"?>

<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
    <xs:element name="carta">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="informacion">
                    <xs:complexType>
                        <xs:sequence> <!-- atributo siempre se escribe después de la secuencia-->
                            <xs:element name="nombre" type="xs:string"/>
                            <xs:element name="ubicacion" type="xs:string"/>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
                <xs:element name="seccion" minOccurs="1" maxOccurs="unbounded">
                    <xs:complexType>
                        <xs:sequence> <!-- atributo siempre se escribe después de la secuencia-->
                            <xs:element name="titulo" type="xs:string"/>
                            <xs:element name="plato" minOccurs="0" maxOccurs="unbounded"> 
                                <xs:complexType>
                                    <xs:sequence> <!-- atributo siempre se escribe después de la secuencia-->
                                        <xs:element name="nombre" type="xs:string"/>
                                        <xs:element name="descripcion" type="xs:string" minOccurs="0"/>
                                        <xs:element name="precio">
                                            <xs:complexType>
                                                <xs:simpleContent>
                                                    <xs:extension base="xs:decimal">
                                                        <xs:attribute name="moneda" type="xs:string" fixed='EUR'></xs:attribute>
                                                    </xs:extension>
                                                </xs:simpleContent>
                                            </xs:complexType>
                                        </xs:element>
                                        <xs:element name="recomendacion" minOccurs="0" maxOccurs="unbounded">
                                            <xs:complexType>
                                                <xs:attribute name="plato" type="xs:IDREF" use="required"></xs:attribute>
                                            </xs:complexType>
                                        </xs:element>
                                    </xs:sequence>
                                    <xs:attribute name="id" type="xs:ID" use="required"/>
                                    <xs:attribute name="alergenos" type="xs:string" use="optional"/>
                                    <xs:attribute name="vegano" type="xs:boolean" default="false"/>
                                    <xs:attribute name="frio" type="xs:boolean" default="false"/>
                                    <xs:attribute name="recomendado" type="xs:boolean" default="false"/>
                                </xs:complexType>
                            </xs:element>
                        </xs:sequence>
                        <xs:attribute name="tipo" use="required">
                            <xs:simpleType>
                                <xs:restriction base="xs:string">
                                    <xs:enumeration value="entrantes"/>
                                    <xs:enumeration value="principales"/>
                                    <xs:enumeration value="postres"/>
                                    <xs:enumeration value="bebidas"/>
                                </xs:restriction>
                            </xs:simpleType>
                        </xs:attribute>
                    </xs:complexType>
                </xs:element>
                <xs:element name="reserva" minOccurs="0" maxOccurs="unbounded">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="cliente" type="xs:string"/>
                            <xs:element name="fecha" type="xs:date"/>
                            <xs:element name="personas">
                                <xs:simpleType>
                                    <xs:restriction base="xs:positiveInteger">
                                    <xs:maxInclusive value="20"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                        </xs:sequence>
                        <xs:attribute name="id" type="xs:ID" use="required"/>
                        <xs:attribute name="plato" type="xs:IDREF" use="optional"/>
                        <xs:attribute name="estado" default="pendiente">
                            <xs:simpleType>
                            <xs:restriction base="xs:string">
                                <xs:enumeration value="pendiente"/>
                                <xs:enumeration value="confirmada"/>
                                <xs:enumeration value="cancelada"/>
                            </xs:restriction>
                            </xs:simpleType>
                        </xs:attribute>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
            <xs:attribute name="nombre" type="xs:string" use="required"/>
            <xs:attribute name="recomendado" type="xs:boolean" default="false"/>
        </xs:complexType>
    </xs:element>
</xs:schema>